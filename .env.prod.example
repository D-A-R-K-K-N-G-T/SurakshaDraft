# Copy to `.env.prod` ON THE SERVER and fill in. Never commit the filled copy —
# .gitignore covers it.
#
#   cp .env.prod.example .env.prod && nano .env.prod
#
# IMPORTANT: this file is consumed two ways at once and they behave differently.
#   * `--env-file .env.prod` feeds ${...} substitution INSIDE docker-compose.prod.yml
#   * `env_file:` injects these same names into the containers
# Values are NOT interpolated within this file. Writing ${POSTGRES_PASSWORD}
# inside DATABASE_URL will be passed through literally — spell the password out.

# ------------------------------------------------------------ host sizing ---
# Per-container memory ceilings. The compose defaults assume a 1 GiB t3.micro
# and are deliberately tight; MEM_API in particular sits close to what the
# container really uses, so on anything larger raise them and give the app room.
#
#   t3.micro  (1 GiB) — leave every line below commented out
#   t3.small  (2 GiB) — uncomment the block as written
#   t3.medium (4 GiB) — uncomment and double MEM_API / MEM_WORKER
#
# MEM_DB=512m
# MEM_REDIS=128m
# MEM_MIGRATE=512m
# MEM_API=640m
# MEM_WORKER=640m
# MEM_GATEWAY=256m
# MEM_NGINX=64m

# ---------------------------------------------------------------- database ---
POSTGRES_USER=suraksha
POSTGRES_DB=suraksha
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGEME_long_random_password

# Host is the compose service name `db`, not localhost. Driver must stay psycopg
# (v3) — psycopg2 is not a dependency of this project.
# Must spell out the same password as POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+psycopg://suraksha:CHANGEME_long_random_password@db:5432/suraksha
DATABASE_ECHO=false

# ------------------------------------------------------------- task queue ---
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- S3 blobs ---
# Free tier: 5 GB of S3 Standard for 12 months. Bucket must be in the same
# region as the instance or you pay cross-region transfer.
S3_BUCKET=suraksha-blobs-CHANGEME
AWS_REGION=ap-south-1

# Leave BOTH of the next three EMPTY on AWS. Empty endpoint makes boto3 and the
# JS SDK resolve the real regional S3 endpoint; empty keys make them fall
# through to the EC2 instance role, so no long-lived credentials sit on disk.
# (Only set these to point at a local MinIO.)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ----------------------------------------------------------- PII encryption --
# 32-byte key as 64 hex chars. Generate: openssl rand -hex 32
# Losing this key makes every stored blob permanently unreadable — back it up
# somewhere outside the instance before going live.
PII_MASTER_KEY=CHANGEME_64_hex_chars

# ----------------------------------------------------------------- identity --
# disabled | demo | firebase.  `demo` treats the bearer token AS the user id —
# never expose that publicly. For `firebase`, drop the service-account JSON at
# ./secrets/firebase.json on the host (compose mounts ./secrets read-only).
AUTH_MODE=firebase
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/firebase.json

# --------------------------------------------------------------------- LLM ---
# gemini | watsonx
LLM_PROVIDER=watsonx

GOOGLE_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.1-flash-lite

# config.py reads WATSONX_API_KEY; the langchain-ibm SDK separately reads
# WATSONX_APIKEY. Set both to the same value or one of the two paths fails.
WATSONX_API_KEY=
WATSONX_APIKEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=

# ------------------------------------------------------------ pipeline behaviour
# Read master LORs from the DB catalogue rather than the bundled JSON files.
RULESET_SOURCE=db
# The DB is the system of record for draft packs; the ./out dump is debug-only.
WRITE_PACK_FILES=false
# Records every LLM call into llm_invocations. Useful audit trail, small write
# cost — leave on unless the DB volume becomes a concern.
RECORD_LLM_INVOCATIONS=true

DOC_GATE_MODE=enforce
LOR_GATE_MODE=enforce

# ------------------------------------------------------------- observability --
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=surakshadraft-prod
