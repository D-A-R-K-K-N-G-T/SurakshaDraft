# Build context hygiene. Without this the context is ~50 MB of node_modules and
# sample JPEGs, which on a t3.micro is a real chunk of the build time.
.git
.github
.pytest_cache
**/__pycache__
**/*.pyc

# Reinstalled inside the image by `npm ci`; a host copy would be the wrong
# platform's binaries anyway.
backend/node_modules
backend/uploads

# Secrets never belong in an image layer — they arrive at runtime via env_file.
.env
.env.prod

# Local artefacts and fixtures.
out/
agentic_pipeline/out/
*.jpg
*.jpeg
*.png
*.pdf
scenario_*.json
test_run.py

# The Flutter client is not deployed to the server.
mobile_app
